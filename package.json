{
  "name": "gogoyao-blog-source",
  "private": true,
  "version": "1.0.0",
  "description": "Codex-managed source and publishing checks for GOGOYAO.github.io",
  "scripts": {
    "build": "node tools/build.cjs",
    "check": "node tools/check.cjs",
    "new": "node tools/new.cjs",
    "preview": "node tools/preview.cjs",
    "preview-drafts": "node tools/build.cjs --drafts && node tools/preview.cjs",
    "list": "node tools/list.cjs",
    "test": "node --test tests/*.test.cjs",
    "publish": "npm run build && npm run check",
    "import": "node tools/import.cjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "gray-matter": "^4.0.3",
    "hexo": "^8.1.2",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.1"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
